DATABASE_URL="file:./dev.db"
# Generate an API secret with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Set the generated value as JWT_SECRET in your private .env file.
JWT_EXPIRES_IN="8h"
API_HOST=127.0.0.1
API_ALLOW_LAN=false
# For LAN use, set API_ALLOW_LAN=true and list exact web origins, comma-separated.
API_ALLOWED_ORIGINS=
VITE_PUBLIC_CLIENT_BASE_URL=http://192.168.1.11:5173
STORE_ID=magasin-demo
STORE_SECRET=change-me-with-a-64-character-random-secret
CLIENT_PORTAL_MODE=cloud
CLOUD_RELAY_URL=wss://print.bv-expedition.fr/ws
CLOUD_PUBLIC_URL=https://print.bv-expedition.fr
# Développement local uniquement : ws://127.0.0.1:4444/ws
CLOUD_RELAY_ALLOW_INSECURE=false
RELAY_PORT=4444
RELAY_SESSION_SECRET=change-me-with-another-random-secret
