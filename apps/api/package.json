{
  "name": "@bv/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/app.js",
  "types": "./dist/app.d.ts",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js",
      "default": "./dist/app.js"
    },
    "./cloud": {
      "types": "./dist/cloud/cloud.connection.service.d.ts",
      "import": "./dist/cloud/cloud.connection.service.js",
      "default": "./dist/cloud/cloud.connection.service.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --pretty",
    "lint": "eslint ."
  },
  "dependencies": {
    "@bv/database": "workspace:*",
    "@bv/printer": "workspace:*",
    "@bv/shared": "workspace:*",
    "ws": "^8.18.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.1.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2"
  }
}
