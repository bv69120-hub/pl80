{
  "name": "@bv/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && tsc -p tsconfig.electron.json",
    "package:win": "electron-builder --win nsis --x64",
    "typecheck": "tsc -b --pretty && tsc -p tsconfig.electron.json --pretty --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@bv/api": "workspace:^",
    "@bv/database": "workspace:^",
    "@bv/printer": "workspace:^",
    "@bv/shared": "workspace:*",
    "@bv/ui": "workspace:*",
    "@vitejs/plugin-react": "^4.3.4",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "electron": "^43.1.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^2.1.8"
  },
  "build": {
    "appId": "fr.bureauvallee.expeditionpro",
    "productName": "BV Expedition Pro",
    "artifactName": "BV-Expedition-Pro-Setup.exe",
    "asar": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "node_modules/.prisma/**/*",
      "!**/.turbo/**",
      "!**/*.tsbuildinfo",
      "!**/release/**",
      "!**/node_modules/.cache/**"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "build/database/bv-expedition.db",
        "to": "database/bv-expedition.db"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build/tools/SumatraPDF.exe",
        "to": "tools/SumatraPDF.exe"
      },
      {
        "from": "build/tools/SumatraPDF.exe.sha256",
        "to": "tools/SumatraPDF.exe.sha256"
      },
      {
        "from": "node_modules/.prisma",
        "to": "app/node_modules/.prisma"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BV Expedition Pro"
    }
  }
}
