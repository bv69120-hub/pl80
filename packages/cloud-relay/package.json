    "typecheck": "tsc -p tsconfig.json --pretty",
    "lint": "eslint ."
  },
  "dependencies": {
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "multer": "^2.2.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^2.1.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2"
  }
}
